# 复制为 .env 并按需修改

# 数据库(默认 SQLite,无需额外服务;生产切 Postgres+pgvector)
DATABASE_URL=sqlite:///./data/app.db

# LLM 网关(OpenAI 兼容接口,默认指向 deepseek-v4-pro)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT=60

# 置为 true 时不调用真实模型,用词典/规则兜底,便于本地跑通链路
MOCK_LLM=true

# 记忆召回参数
RECALL_TOP_K=8
RECALL_ALPHA=0.35
RECALL_BETA=0.35
RECALL_GAMMA=0.30

# 语音 TTS/ASR(腾讯 MaaS 代理转发 MiniMax TTS / 混元 ASR)
MAAS_BASE_URL=https://tokenhub.tencentmaas.com
MAAS_API_KEY=
TTS_MODEL=minimax-speech-2.8-hd
TTS_VOICE_ID=female-shaonv
ASR_MODEL=hy-asr-3.0-preview

# 对象存储(腾讯云 COS;私有桶,语音走预签名 URL 喂给 ASR)
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=
